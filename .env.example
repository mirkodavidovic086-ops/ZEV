# =============================================================================
#  MojZEV — primjer konfiguracije za SUPABASE CLI i EDGE FUNCTIONS
#  Kopiraj u `.env` i popuni. `.env` je u .gitignore i NE commituje se.
#
#  ⚠️  Flutter aplikacija NE čita ovaj fajl (nema `flutter_dotenv`). Njena
#      konfiguracija ide kroz `--dart-define-from-file` — koristi
#      `env.example.json` → `.env.json`. Vidi README, sekcija Pokretanje.
# =============================================================================

# --- Supabase (klijent) ------------------------------------------------------
# Vrijednosti dobiješ komandom `supabase status` nakon `supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Okruženje ---------------------------------------------------------------
# dev | staging | prod
OKRUZENJE=dev

# =============================================================================
#  ⚠️  SAMO ZA SERVER — NIKAD U FLUTTER APLIKACIJU
# =============================================================================
#  `service_role` ključ zaobilazi SVE RLS politike. Ako dospije u klijent,
#  svaki korisnik može pročitati i izmijeniti podatke bilo koje zgrade.
#  Živi isključivo u Edge Functions secrets i CI secrets:
#      supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#  Vidi CLAUDE.md, sekcija 4.5.
# =============================================================================
# SUPABASE_SERVICE_ROLE_KEY=

# --- Provajder SMS/Viber OTP (Edge Function `posalji-otp`) -------------------
# OTP_PROVAJDER_URL=
# OTP_PROVAJDER_KLJUC=
# VIBER_SENDER_ID=
